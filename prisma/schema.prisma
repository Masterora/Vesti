generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractStatus {
  open
  claimed
  draft
  active
  completed
  cancelled
  disputed
}

enum MilestoneStatus {
  pending
  ready
  submitted
  revision_requested
  approved
  released
  disputed
}

enum EventType {
  contract_created
  contract_claim_requested
  contract_claim_accepted
  contract_funded
  contract_activated
  milestone_ready
  milestone_proof_submitted
  milestone_revision_requested
  milestone_approved
  milestone_released
  contract_completed
  contract_cancelled
  contract_disputed
  dispute_resolution_proposed
  contract_dispute_resolved
  contract_refunded
}

enum EscrowTransactionAction {
  fund
  release
  dispute
  resolve
  refund
}

enum EscrowTransactionMode {
  mock
  onchain
}

enum EscrowTransactionKind {
  fund
  release
  dispute_open
  dispute_propose
  dispute_accept_release
  dispute_accept_refund
  dispute_arbitrate_release
  dispute_arbitrate_refund
}

enum EscrowTransactionStatus {
  building
  signed
  prepared
  submitted
  confirmed
  reconciled
  failed
}

enum DisputeStatus {
  open
  proposed
  resolved
}

enum DisputeOutcome {
  release_to_worker
  refund_to_creator
}

enum DisputePolicy {
  bilateral
  arbitrator
}

model User {
  id              String    @id @default(cuid())
  walletAddress   String    @unique
  displayName     String?
  email           String?   @unique
  bio             String?
  avatarImage     String?
  avatarUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdContracts Contract[] @relation("UserCreatedContracts")
  workedContracts  Contract[] @relation("UserWorkedContracts")
}

model WalletAuthChallenge {
  id            String    @id @default(cuid())
  walletAddress String
  nonce         String    @unique
  message       String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([walletAddress])
  @@index([expiresAt])
}

model ApiRateLimitBucket {
  bucketKey    String
  windowStart  DateTime
  requestCount Int      @default(1)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([bucketKey, windowStart])
  @@index([expiresAt])
}

model Contract {
  id                    String         @id @default(cuid())
  displayId             String         @unique
  creatorWallet         String
  workerWallet          String?
  disputePolicy         DisputePolicy  @default(bilateral)
  arbitratorWallet      String?
  requestedWorkerWallet String?
  title                 String
  description           String?
  tags                  String[]       @default([])
  isPublic              Boolean        @default(false)
  totalAmount           Decimal        @db.Decimal(18, 6)
  fundedAmount          Decimal        @default(0) @db.Decimal(18, 6)
  releasedAmount        Decimal        @default(0) @db.Decimal(18, 6)
  refundedAmount        Decimal        @default(0) @db.Decimal(18, 6)
  status                ContractStatus @default(draft)
  chainSyncStatus       String         @default("uninitialized")
  chainBaselineKind     String         @default("absent")
  chainBaselineEvidence Json?
  chainReviewAt         DateTime?
  chainReviewCode       String?
  chainReviewEvidence   Json?
  chainLastSyncedSlot   BigInt?
  chainLastSyncedTransactionIndex Int?
  chainLastSyncedInstructionIndex Int?
  businessRevision      BigInt         @default(0)
  escrowAccount         String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  milestones         Milestone[]
  events             Event[]
  comments           ContractComment[]
  applications       ContractApplication[]
  escrowTransactions EscrowTransaction[]
  disputes           Dispute[]
  chainInstructions  ChainAppliedInstruction[]
  creatorUser        User?                 @relation("UserCreatedContracts", fields: [creatorWallet], references: [walletAddress], onDelete: NoAction, onUpdate: Cascade)
  workerUser         User?                 @relation("UserWorkedContracts", fields: [workerWallet], references: [walletAddress], onDelete: SetNull, onUpdate: Cascade)

  @@index([creatorWallet])
  @@index([workerWallet])
  @@index([requestedWorkerWallet])
  @@index([status])
}

model ContractApplication {
  id              String   @id @default(cuid())
  contractId      String
  applicantWallet String
  createdAt       DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, applicantWallet])
  @@index([contractId, createdAt])
  @@index([applicantWallet])
}

model ContractComment {
  id           String   @id @default(cuid())
  contractId   String
  authorWallet String
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
  @@index([authorWallet])
}

model Milestone {
  id          String          @id @default(cuid())
  contractId  String
  index       Int
  title       String
  description String?
  amount      Decimal         @db.Decimal(18, 6)
  dueAt       DateTime?
  status      MilestoneStatus @default(pending)
  submittedAt DateTime?
  approvedAt  DateTime?
  releasedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  contract           Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  proofSubmissions   ProofSubmission[]
  events             Event[]
  escrowTransactions EscrowTransaction[]
  disputes           Dispute[]

  @@unique([contractId, index])
  @@index([contractId])
  @@index([status])
}

model ProofSubmission {
  id          String   @id @default(cuid())
  milestoneId String
  submittedBy String
  note        String
  proofUrl    String?
  proofHash   String?
  version     Int
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, version])
  @@index([milestoneId])
  @@index([submittedBy])
}

model Event {
  id          String    @id @default(cuid())
  contractId  String
  milestoneId String?
  actorWallet String
  eventType   EventType
  payload     Json?
  txSig       String?
  createdAt   DateTime  @default(now())

  contract  Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([contractId, createdAt])
  @@index([milestoneId])
  @@index([eventType])
  @@index([createdAt])
}

model EscrowTransaction {
  id                           String                  @id @default(cuid())
  contractId                   String
  milestoneId                  String?
  kind                         EscrowTransactionKind?
  contextVersion               Int                     @default(0)
  operationContext             Json?
  logicalOperationKey          String?
  attempt                      Int                     @default(0)
  contractLockKey              String?                 @unique
  buildToken                   String?
  buildExpiresAt               DateTime?
  signedTransaction            String?
  signedAt                     DateTime?
  messageHash                  String?
  lastValidBlockHeight         BigInt?
  finalizedSlot                BigInt?
  finalizedTransactionIndex    Int?
  action                       EscrowTransactionAction
  mode                         EscrowTransactionMode
  walletAddress                String
  amount                       Decimal?                @db.Decimal(18, 6)
  idempotencyKey               String                  @unique
  operationKey                 String?                 @unique
  txSig                        String?                 @unique
  preparedTransaction          String?
  recentBlockhash              String?
  status                       EscrowTransactionStatus @default(prepared)
  errorCode                    String?
  errorMessage                 String?
  reconciliationAttempts       Int                     @default(0)
  lastAttemptAt                DateTime?
  nextAttemptAt                DateTime?
  requiresReviewAt             DateTime?
  reconciliationLeaseId        String?
  reconciliationLeaseExpiresAt DateTime?
  submittedAt                  DateTime?
  confirmedAt                  DateTime?
  reconciledAt                 DateTime?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  contract  Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([milestoneId, createdAt])
  @@index([status])
  @@unique([logicalOperationKey, attempt])
  @@index([status, nextAttemptAt])
  @@index([status, reconciliationLeaseExpiresAt])
  @@index([requiresReviewAt])
}

model Dispute {
  id                      String          @id @default(cuid())
  contractId              String
  milestoneId             String          @unique
  openedBy                String
  source                  String          @default("web")
  chainAddress            String?
  milestoneHash           String?
  reasonHash              String?
  proposalVersion         BigInt          @default(0)
  proposedAmountUnits     String?
  settledAmountUnits      String?
  resolvedBy              String?
  resolutionKind          String?
  reason                  String?
  previousMilestoneStatus MilestoneStatus
  status                  DisputeStatus   @default(open)
  proposedOutcome         DisputeOutcome?
  proposedBy              String?
  resolvedAt              DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  contract  Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
  @@index([status])
}

model ChainAppliedInstruction {
  id                    String   @id @default(cuid())
  networkGenesisHash    String
  programId             String
  contractId            String
  txSig                 String
  slot                  BigInt
  transactionIndex      Int
  instructionIndex      Int
  kind                  String
  parameters            Json
  evidenceHash          String
  appliedAt             DateTime @default(now())
  contract              Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  @@unique([networkGenesisHash, programId, txSig, instructionIndex])
  @@index([contractId, slot, transactionIndex, instructionIndex])
}
