DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vesti
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_USDC_MINT=
ESCROW_ADAPTER_MODE=mock
ESCROW_PROGRAM_ID=ErFsmiKY7WxjD9ArYmpqjCCUKnTcfzLm6tFpmWdFU9ck
RECONCILIATION_BATCH_SIZE=25
RECONCILIATION_MAX_ATTEMPTS=12
AUTH_SECRET=replace-with-a-long-random-secret

# Durable on-chain protocol pins. Required for funding/release in onchain mode.
# Genesis hash and SHA256 of deployed program bytes (ProgramData payload for upgradeable programs).
ESCROW_NETWORK_GENESIS_HASH=
ESCROW_PROGRAM_SHA256=
# Disputes require an approved localnet/Devnet release; disabled by default.
ESCROW_CHAIN_DISPUTES_ENABLED=false

# Iteration 3: separately approved manifest and fail-closed new operations gate.
ESCROW_RELEASE_ID=
ESCROW_RELEASE_MANIFEST_PATH=
ESCROW_CHAIN_NEW_OPERATIONS_ENABLED=false
# Server-only private RPC. Never use provider secrets in NEXT_PUBLIC_* variables.
SOLANA_SERVER_RPC_URL=
# Immutable historical registry required for same-ID release conversion.
ESCROW_PROTOCOL_REGISTRY_PATH=
ESCROW_PROTOCOL_REGISTRY_SHA256=
# Use independent hostnames, or different cookie names for localnet and Devnet.
AUTH_SESSION_COOKIE_NAME=vesti_session
